%%{init: {"theme": "base"}}%%
graph TD
    subgraph Workstation["Workstation (local)"]
        BIN["bin/knife\n<b>bin/knife</b>"]
        APP["Chef::Application::Knife\n<b>lib/chef/application/knife.rb</b>"]
        CORE["Chef::Knife base class\n<b>lib/chef/knife.rb</b>"]

        subgraph Subcommands["Subcommands — lib/chef/knife/*.rb"]
            BS["Chef::Knife::Bootstrap\n<b>lib/chef/knife/bootstrap.rb</b>"]
            ST["Chef::Knife::Status\n<b>lib/chef/knife/status.rb</b>"]
            CB["Chef::Knife::CookbookUpload\n<b>lib/chef/knife/cookbook_upload.rb</b>"]
            NL["node_edit / node_list / …\n<b>lib/chef/knife/node_*.rb</b>"]
            OTH["50+ other commands\n<b>lib/chef/knife/*.rb</b>"]
        end

        subgraph CoreUtils["Core Utilities — lib/chef/knife/core/"]
            UI["UI output layer\n<b>core/ui.rb</b>"]
            FMT["Text formatter\n<b>core/text_formatter.rb</b>"]
            BSH["Bootstrap context\n<b>core/bootstrap_context.rb</b>"]
            LOADER["Command loader\n<b>core/subcommand_loader.rb</b>"]
            PRES["Status presenter\n<b>core/status_presenter.rb</b>"]
            RB["RetryWithBackoff\n<b>core/retry_with_backoff.rb</b>"]
        end

        subgraph ChefFS["Chef-FS — lib/chef/chef_fs/"]
            FS["Local/server sync\n<b>lib/chef/chef_fs/knife.rb</b>"]
        end

        subgraph Utils["Utilities — lib/chef/utils/"]
            LIC["Licensing handler\n<b>utils/licensing_handler.rb</b>"]
        end
    end

    subgraph Transport["Transport Layer (gems)"]
        TR["train-core\n~> 3.13"]
        TRWIN["train-winrm\n>= 0.2.17"]
        SSH["net-ssh\n>= 5.1"]
    end

    subgraph Remote["Remote Systems"]
        SRV["Chef Infra Server\nREST API /nodes /cookbooks …"]
        NODE_LINUX["Linux Node\nSSH"]
        NODE_WIN["Windows Node\nWinRM"]
    end

    subgraph Testing["Test Suite — spec/"]
        UNIT["spec/unit/\n2500+ examples"]
        FUNC["spec/functional/"]
        INTG["spec/integration/"]
    end

    %% Startup flow
    BIN -->|"1 - require + run"| APP
    APP -->|"2 - load subcommand"| LOADER
    LOADER -->|"3 - instantiate"| CORE
    CORE -->|"4 - dispatch"| Subcommands

    %% Core wiring
    CORE --> CoreUtils
    CORE --> ChefFS
    CORE --> Utils

    %% Data flow A — knife bootstrap
    BS -->|"A1 - build context"| BSH
    BSH -->|"A2 - render template"| TR
    TR -->|"A3 - SSH connect"| SSH
    TR -->|"A4 - WinRM connect"| TRWIN
    SSH -->|"A5 - run install script"| NODE_LINUX
    TRWIN -->|"A5 - run install script"| NODE_WIN

    %% Data flow B — knife status
    ST -->|"B1 - search query"| SRV
    SRV -->|"B2 - node list JSON"| ST
    ST -->|"B3 - format + print"| PRES
    PRES -->|"B4 - render to stdout"| UI

    %% Data flow C — cookbook upload via ChefFS
    CB -->|"C1 - read local cookbook"| FS
    FS -->|"C2 - diff local vs server"| SRV
    SRV -->|"C3 - upload response"| CB

    %% Data flow D — resilience wrapper (Walk Ex15)
    OTH -->|"D1 - wrap external GET"| RB
    RB -->|"D2 - retry on transient error"| SRV

    %% Test coverage
    CORE -.->|tested by| UNIT
    Subcommands -.->|tested by| UNIT
    Subcommands -.->|tested by| FUNC
    SRV -.->|tested by| INTG
